flowchart TD
  A(["Ссылка в чате класса, родительском чате или поиск в MAX"]) --> B["Бот: /start и выбор роли"]
  B -->|"Ученик"| N1["Имя из профиля MAX: подтвердить или исправить"]
  B -->|"Родитель"| N2["Как зовут вашего ребёнка?"]
  N1 --> Q["Класс, регион, предметы"]
  N2 --> Q
  Q --> G{"Есть цель?"}
  G -->|"Знаю направление"| G1["Выбор направления"]
  G -->|"Пока не знаю"| G2["3 вопроса об интересах"]
  G2 --> G1
  G1 --> V["Вузы, куда хочет поступить ученик"]
  V --> R["Итог: сколько олимпиад подходит и ближайший срок"]
  R -->|"Открыть навигатор"| H["Мини-приложение: главная и следующий шаг"]
  R -->|"Напоминать о сроках"| REM
  R -->|"Пригласить в семью"| INV
  H --> SEL["Подбор: 3–5 олимпиад и ВсОШ, фильтры, олимпиады вне перечня"]
  H --> CAT["Каталог: поиск олимпиад и вузов"]
  SEL --> OC["Карточка олимпиады: уровень, льгота в вузах ученика, условия, этапы"]
  CAT --> OC
  CAT --> VC["Карточка вуза: олимпиады с льготой, ЕГЭ, правила приёма"]
  OC --> VC
  VC --> OC
  OC --> WHO{"Кто добавляет?"}
  WHO -->|"Ученик или траектория без ученика"| TR["Трекер: статусы, календарь"]
  WHO -->|"Родитель"| PR["Предложение ученику в чате"]
  PR --> CF{"Ученик подтвердил?"}
  CF -->|"Добавить"| TR
  CF -.->|"Не сейчас"| OC
  TR --> REM["Напоминания всем: за месяц, неделю, 3 дня и 1 день"]
  REM --> RG{"Зарегистрировались?"}
  RG -->|"Отметил любой участник"| DONE["Статус «зарегистрирован», новый следующий шаг"]
  RG -.->|"Напомнить завтра"| REM
  H -->|"Спросить"| AI["ИИ-помощник: последний чат, помнит 10 реплик"]
  AI -->|"Чаты"| AIL["Список чатов: свежие сверху"]
  AIL -->|"Выбрать"| AI
  AIL -->|"Новый чат"| AIE["Пустой чат с подсказками"]
  AIE -->|"Первый вопрос"| AIT["Чат назван по дню: «Чат 21 сентября»"]
  AIT --> AI
  AI -.->|"Переименовать"| AIR["Своё название чата"]
  AI --> AIQ{"Есть карточки: по последнему вопросу или из прошлых ответов?"}
  AIQ -->|"Да"| AIA["Ответ с учётом разговора: карточка и источник"]
  AIQ -.->|"Нет"| AIN["«Данных нет» и первоисточник"]
  INV["Одноразовая ссылка-приглашение"] --> J["Приглашённый: приветствие по имени, подтвердить имя и цель"]
  J --> SH["Общая траектория: те же олимпиады, сроки и статусы"]
  SH --> TR
  SH --> M{"Участники"}
  M -->|"Создатель"| DEL["Удалить участника или всю траекторию"]
  M -->|"Приглашённый"| OUT["Выйти из траектории"]
  UPD(["Изменился перечень или правила вуза"]) -.-> NT["Уведомление в чат"]
  NT -.-> OC
  classDef chat fill:#E6EFFF,stroke:#1A6DFF,color:#17142A
  classDef app fill:#EFE8FF,stroke:#6B2BFF,color:#17142A
  classDef fam fill:#FFE8F1,stroke:#E92E78,color:#17142A
  class B,N1,N2,Q,G1,G2,V,R,REM,PR,NT chat
  class H,SEL,CAT,OC,VC,TR,DONE,AI,AIL,AIE,AIT,AIR,AIA,AIN app
  class INV,J,SH,DEL,OUT fam
