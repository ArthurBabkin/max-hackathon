# {{ ansible_managed }}
# Файл включается из postgresql.conf через include_dir = 'conf.d' и
# переопределяет значения выше. Править руками бессмысленно — перезапишется.

# Функции ходят снаружи VPC, поэтому слушаем не только localhost. Единственное,
# что отделяет базу от интернета, — TLS и scram-sha-256 в pg_hba.conf.
listen_addresses = '*'
port = 5432

# Пароли храним только в scram-sha-256: md5 давно не считается приемлемым.
password_encryption = 'scram-sha-256'

# Сертификат — самоподписанный ssl-cert-snakeoil из пакета ssl-cert: клиенты
# подключаются с sslmode=require, то есть шифруют канал, не проверяя издателя.
# Доверенный сертификат для внутреннего хоста выпускать незачем.
ssl = on

max_connections = {{ pg_max_connections }}
shared_buffers = {{ pg_shared_buffers }}

# На маленькой ВМ важнее не разогнать, а не уйти в своп.
work_mem = 8MB
maintenance_work_mem = 128MB
effective_cache_size = 1GB

# Диск сетевой, произвольное чтение обходится почти как последовательное.
random_page_cost = 1.5

# Журнал: пишем медленные запросы и всё, что не тривиально, — при разборе
# инцидента на окне проверки это единственный источник правды.
log_min_duration_statement = 500
log_checkpoints = on
log_connections = off
log_line_prefix = '%m [%p] %q%u@%d '
log_timezone = 'UTC'
timezone = 'UTC'
