# {{ ansible_managed }}
# Порядок важен: выигрывает первое совпадение.

# Локально — по имени системного пользователя, без пароля. Так ходят
# обслуживание и бэкап с самой ВМ.
local   all             postgres                                peer
local   all             all                                     peer

# Снаружи — только hostssl: строк host без ssl здесь нет намеренно, поэтому
# нешифрованное подключение отвергается сервером, а не остаётся на совести
# клиента. Сузить адрес нечем: Cloud Functions работают вне VPC и постоянных
# исходящих адресов не имеют.
hostssl {{ pg_name }}   {{ pg_name }}   0.0.0.0/0               scram-sha-256
hostssl {{ pg_name }}   {{ pg_name }}   ::/0                    scram-sha-256
