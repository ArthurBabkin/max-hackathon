# Статика мини-приложения MAX.
#
# Сборочной стадии нет намеренно: сейчас это один index.html без npm-зависимостей,
# и multi-stage добавил бы к сборке установку Node ради копирования файла.
# Когда появится бандлер, сюда встанет стадия `FROM node:20-alpine AS build`.
#
# Контекст сборки — КОРЕНЬ репозитория, как у Go-сервисов: так у всех сервисов
# в compose один и тот же `context: ..` и один общий .dockerignore.
FROM nginx:1.27-alpine

# Файлы кладём в образ, а не монтируем томом: образ самодостаточен и проверяющий
# получает ровно ту статику, что лежала в репозитории на момент сборки.
# Копируем каталог целиком, чтобы будущие css/js/картинки подхватывались сами.
COPY apps/web/ /usr/share/nginx/html/

# Сам Dockerfile лежит в apps/web и приезжает вместе с каталогом — убираем его,
# чтобы nginx не раздавал наружу внутреннюю кухню сборки.
RUN rm -f /usr/share/nginx/html/Dockerfile

# Слушаем 8083 вместо дефолтного 80, чтобы внутренний и внешний порт совпадали:
# ссылка http://localhost:8083 одинаково работает и с хоста, и изнутри compose-сети,
# и её не надо переписывать при переходе между окружениями.
#
# Конфиг генерим прямо здесь, чтобы не заводить в репозитории отдельный файл
# ради шести строк. Одинарные кавычки не дают шеллу съесть $uri.
# try_files ... /index.html — задел на клиентский роутинг мини-приложения:
# перезагрузка страницы на внутреннем маршруте не должна отдавать 404.
RUN printf '%s\n' \
    'server {' \
    '    listen 8083;' \
    '    server_name localhost;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 8083
