{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "web-live",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_USE_MOCKS=off", "VITE_DEV_FAKE_WEBAPP=true", "npm", "--prefix", "apps/web", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-u", "-m", "http.server", "5180", "--bind", "127.0.0.1", "--directory", "apps/landing"],
      "port": 5180
    }
  ]
}
