# Скопировать в .env и заполнить. .env в git не попадает.

# Bot API MAX. Токен выдан организаторами капитану команды.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru

# Секрет вебхука: приходит в заголовке X-Max-Bot-Api-Secret при каждом запросе.
# Маска платформы: ^[a-zA-Z0-9_-]{5,256}$ — лучше обойтись латиницей, цифрами и дефисом.
# Пока переменная пуста, функция принимает запросы без проверки подписи.
WEBHOOK_SECRET=

# Подпись JWT для сессий мини-приложения (HS256) и срок жизни токена.
JWT_SECRET=
JWT_TTL=1h

# production | development. В проде (Cloud Functions) — production:
# с ним сервис откажется стартовать, если включён дев-обход подписи ниже.
APP_ENV=production

# Дев-обход проверки initData: принимает НЕподписанную строку заглушки MAX Bridge
# (apps/web/src/bridge/stub.ts), но только для id из диапазона 900000000–900000999,
# которых у настоящих пользователей MAX не бывает. Работает лишь при
# APP_ENV != production. Нужен, чтобы открыть мини-приложение в обычном браузере.
DEV_UNSIGNED_INITDATA=false

# Ник и user_id бота: ссылки-приглашения https://max.ru/<ник>?start=inv_<токен>
# и кнопка open_app, которой нужен id бота (contact_id).
MAX_BOT_NAME=t356_hakaton_max_bot
MAX_BOT_ID=426643746

# Час отправки напоминаний по местному времени ученика (ТЗ §6.3).
REMINDER_HOUR=10

# Managed PostgreSQL, обязательно sslmode=require.
DATABASE_URL=
# Соединений в пуле на один инстанс функции. Инстанс обслуживает один запрос
# за раз, пул нужен ради переиспользования соединения между вызовами.
DB_MAX_CONNS=2

# ИИ-помощник: GigaChat через OpenAI-совместимый шлюз polza.ai.
# Без ключа помощник отвечает только шаблоном «данных нет».
POLZA_AI_API_KEY=
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=GigaChat/GigaChat-3-Pro

# --- Мини-приложение (apps/web) ---------------------------------------------

# Адрес API, зашивается в бандл на сборке. По умолчанию относительный путь:
# nginx мини-приложения проксирует /api/ в Go-сервис, запрос остаётся
# same-origin и CORS локально не нужен. В проде — адрес Cloud Function.
VITE_API_BASE=/api/v1

# Заглушка MAX Bridge для разработки в обычном браузере (ТЗ 11.4).
# В dev включена всегда; переменная нужна только чтобы включить её
# в прод-сборке — например, для показа без мессенджера.
VITE_DEV_FAKE_WEBAPP=false
