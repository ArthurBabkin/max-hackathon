# Скопировать в .env и заполнить. .env в git не попадает.

# Bot API MAX. Токен выдан организаторами капитану команды.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru

# Секрет вебхука: приходит в заголовке X-Max-Bot-Api-Secret при каждом запросе.
# Маска платформы: ^[a-zA-Z0-9_-]{5,256}$ — лучше обойтись латиницей, цифрами и дефисом.
# Пока переменная пуста, функция принимает запросы без проверки подписи.
WEBHOOK_SECRET=

# Подпись JWT для сессий мини-приложения (HS256).
JWT_SECRET=

# Managed PostgreSQL, обязательно sslmode=require.
DATABASE_URL=

# ИИ-помощник. Ключ регистрируется отдельно в личном кабинете Сбера.
GIGACHAT_AUTH_KEY=
