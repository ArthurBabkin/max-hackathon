# Шаблон .env (в git не попадает). Стенду в Docker он не нужен —
# только для живого MAX и ИИ-помощника.

# Bot API MAX. Токен выдают организаторы.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_NAME=t356_hakaton_max_bot
MAX_BOT_ID=426643746

# Секрет вебхука, заголовок X-Max-Bot-Api-Secret: ^[a-zA-Z0-9_-]{5,256}$.
# В облаке обязателен, локально пустой — без проверки.
WEBHOOK_SECRET=

# Бот локально: webhook или poll (long polling, отладка в MAX без HTTPS).
BOT_MODE=webhook

# Подпись сессий мини-приложения (HS256). В production от 32 байт: openssl rand -hex 32.
JWT_SECRET=
JWT_TTL=1h

# production | development | test; пусто — production.
APP_ENV=development

# Вход без подписи MAX для id 900000000–900000999. Только вне production.
DEV_UNSIGNED_INITDATA=true

# Час напоминаний по местному времени ученика.
REMINDER_HOUR=10

# PostgreSQL; в облаке sslmode=require. Пул — соединений на инстанс функции.
DATABASE_URL=
DB_MAX_CONNS=2

# ИИ-помощник: GigaChat через polza.ai. Без ключа — ответ «данных нет».
POLZA_AI_API_KEY=
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=GigaChat/GigaChat-3-Pro

# Адрес мини-приложения для CORS в проде; локально пусто.
CORS_ALLOWED_ORIGINS=

# --- Сборка мини-приложения. Compose берёт отсюда только VITE_API_BASE,
# в проде значения задаёт Deploy web.

# Адрес API: локально /api/v1 через nginx, в проде — API Gateway.
VITE_API_BASE=/api/v1
# Заглушка MAX Bridge: мини-приложение в обычном браузере.
VITE_DEV_FAKE_WEBAPP=false
# Ник бота для кнопки «Пройти анкету»; пусто — t356_hakaton_max_bot.
VITE_MAX_BOT_NAME=
